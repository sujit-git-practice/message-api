# Copy this file to ".env" for local development and fill in real values.
# ".env" is gitignored and never committed.

# --- Cloud SQL connection (via Cloud SQL Postgres socket factory) ---
# Requires Application Default Credentials locally:
#   gcloud auth application-default login
GCP_PROJECT_ID=my-gcp-project
GCP_REGION=us-central1
DB_INSTANCE_CONNECTION_NAME=${GCP_PROJECT_ID}:${GCP_REGION}:message-api-instance

spring.datasource.url=jdbc:postgresql:///message_api?cloudSqlInstance=${DB_INSTANCE_CONNECTION_NAME}&socketFactory=com.google.cloud.sql.postgres.SocketFactory
spring.datasource.username=postgres
spring.datasource.password=changeme
spring.datasource.driver-class-name=org.postgresql.Driver

# --- Plain TCP connection (e.g. local Postgres via docker-compose) ---
# Use this instead of the Cloud SQL url above when not connecting to Cloud SQL:
# spring.datasource.url=jdbc:postgresql://localhost:5432/message_api

# Only needed when running against GCP (Cloud Run / GKE / etc.) so the app can
# fetch spring.datasource.password from Secret Manager instead of setting it above.
# Leave spring.datasource.password unset/blank in that case.
# DB_PASSWORD_SECRET_ID=message-api-db-password
